@extern(embed)

// Package gitops is the root: it lists every cluster and app and renders them.
//
// Apps come from catalog.json, generated by the `catalog` repository (never edit it here); their
// version files are apps/<team>/<app>/{staging,prod}.json. A cluster is a directory and one import
// here. `scripts/gitops_checks.py layout` makes sure the directories agree with both.
package gitops

import (
	"github.com/homelab-selfuryon/gitops/schema"

	alpha01 "github.com/homelab-selfuryon/gitops/clusters/alpha-01:alpha01"
)

clusters: "alpha-01": alpha01.cluster

_catalog: _ @embed(file="catalog.json")

// Every version file, keyed by its path: {"version": "v1.2.0", "digest": "sha256:..."}, or `{}`
// (not released yet, no Application).
_versions: _ @embed(glob="apps/*/*/*.json")

// Keyed by <team>/<name>, the directory under apps/.
apps: {
	for name, a in _catalog.apps {
		"\(a.team)/\(name)": schema.#App & {
			"name":  name
			team:    a.team
			repo:    a.repo
			cluster: a.cluster
			preview: a.preview
			staging: _versions["apps/\(a.team)/\(name)/staging.json"]
			prod:    _versions["apps/\(a.team)/\(name)/prod.json"]
		}
	}
}

rendered: schema.#Render & {
	"clusters": clusters
	"apps":     apps
}
